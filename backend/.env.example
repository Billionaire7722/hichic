# Application
PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=hichic_user
DB_PASSWORD=hichic_pass
DB_NAME=hichic_db

# CORS: allow the Vite dev server. Use comma-separated origins for local aliases.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_PRODUCT_FOLDER=hichic/products
