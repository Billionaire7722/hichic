# OpenTryOn lightweight compatibility service
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8001
OPENTRYON_REPO_DIR=../opentryon
OPENTRYON_PROVIDER=segmind
OPENTRYON_MAX_UPLOAD_MB=12
OPENTRYON_OUTPUT_DIR=outputs
OPENTRYON_TEMP_DIR=tmp

# Segmind Try-On Diffusion, lowest local resource path.
SEGMIND_API_KEY=
# Defaults to SegFit v1.3 because it is current and faster than the older try-on-diffusion endpoint.
OPENTRYON_SEGMIND_ENDPOINT=segfit-v1.3
OPENTRYON_SEGMIND_MODEL_TYPE=Speed
OPENTRYON_SEGMIND_CN_STRENGTH=0.8
OPENTRYON_SEGMIND_CN_END=0.5
OPENTRYON_SEGMIND_IMAGE_FORMAT=png
OPENTRYON_SEGMIND_IMAGE_QUALITY=90
OPENTRYON_SEGMIND_TIMEOUT_SECONDS=600
OPENTRYON_SEGMIND_SEED=-1

# Legacy OpenTryOn adapter options, used only with OPENTRYON_SEGMIND_ENDPOINT=try-on-diffusion.
OPENTRYON_SEGMIND_STEPS=25
OPENTRYON_SEGMIND_GUIDANCE_SCALE=2

# Kling AI, optional.
KLING_AI_API_KEY=
KLING_AI_SECRET_KEY=
KLING_AI_BASE_URL=https://api-singapore.klingai.com
OPENTRYON_KLING_MODEL=

# Amazon Nova Canvas via AWS Bedrock, optional.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AMAZON_NOVA_REGION=us-east-1
AMAZON_NOVA_MODEL_ID=amazon.nova-canvas-v1:0
